# REJCC — Dashboard (dashboard.rejcc.site) : administration générale et
# espaces des départements du Bureau. Parle à l'API (REJCC-Backend) et partage
# les fichiers du site (REJCC-Frontend).
APP_NAME="REJCC Dashboard"
APP_ENV=production
# MÊME clé que REJCC-Frontend : le coffre-fort des membres est chiffré avec elle.
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.rejcc.site

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# API du REJCC
BACKEND_API_URL=https://api.rejcc.site/api
# Site public et espace membre (liens sortants)
SITE_URL=https://rejcc.site

# Fichiers partagés avec le site (chemins absolus sur le serveur)
SHARED_PRIVATE_ROOT=/home/IDENTIFIANT/apps/rejcc/REJCC-Frontend/storage/app/private
SHARED_UPLOADS_ROOT=/home/IDENTIFIANT/apps/rejcc/REJCC-Frontend/public/uploads
SHARED_UPLOADS_URL=https://rejcc.site/uploads

VITE_APP_NAME="${APP_NAME}"
